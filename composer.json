{
  "name": "yuran/programmer-life-site",
  "description": "Humorous PHP game project 'Zhizn Programmista'",
  "type": "project",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.59",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "vendor/bin/phpunit --configuration phpunit.xml.dist",
    "lint": "@php tests/Tools/php-lint.php",
    "format": "@php -d sys_temp_dir=storage/tmp vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php",
    "format:check": "@php -d sys_temp_dir=storage/tmp vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
